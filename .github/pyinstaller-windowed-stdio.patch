+#if defined(WINDOWED)
+static bool
+_pyi_stream_handle_usable(HANDLE handle)
+{
+    DWORD flags;
+    if (!GetHandleInformation(handle, &flags) || !(flags & HANDLE_FLAG_INHERIT)) {
+        return false;
+    }
+    SetLastError(ERROR_SUCCESS);
+    DWORD type = GetFileType(handle);
+    if (type == FILE_TYPE_UNKNOWN) {
+        return GetLastError() == ERROR_SUCCESS;
+    }
+    if (type == FILE_TYPE_DISK) {
+        /* CPython needs file information when opening a disk stream. */
+        BY_HANDLE_FILE_INFORMATION info;
+        FILE_BASIC_INFO basic_info;
+        return GetFileInformationByHandle(handle, &info) &&
+            GetFileInformationByHandleEx(handle, FileBasicInfo, &basic_info, sizeof(basic_info));
+    }
+    return true;
+}
+#endif
 
